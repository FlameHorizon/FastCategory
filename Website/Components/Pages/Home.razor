@page "/"
@rendermode InteractiveServer

@using Core
@using System.Runtime.CompilerServices
@using System.Runtime.InteropServices
@using System.Threading.Tasks
@using System.Globalization
@using System.Diagnostics.CodeAnalysis
@using System.Text
@using Website.Models
@using MudBlazor.Extensions
@using System.ComponentModel.DataAnnotations
@inject ISnackbar Snackbar

@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions

<PageTitle>Home</PageTitle>

@* 
  @@HACK: For some reason <div class="d-flex gap-4 justify-content-center"> does not justifies content.
  Maybe, css file is missing?
  Using style="..." instead.
  Same thing goes for align-items.
  Maybe using MudGrid would be better here?
  https://mudblazor.com/components/grid#basic-grid
*@
<div class="d-flex flex-column gap-4" style="justify-content: center; align-items: center">
  <MudItem xs="12" sm="6" md="6">
    
    @* TODO: Think about have I can make this button a bit nicer. Although it is not ugly right now. *@
    <MudFileUpload T="IBrowserFile" FilesChanged="UploadBankStatement" Accept=".csv">
        <ActivatorContent>
            <MudButton Variant="Variant.Filled"
                      Color="Color.Primary"
                      StartIcon="@Icons.Material.Filled.CloudUpload">
                Upload bank statement
            </MudButton>
        </ActivatorContent>
    </MudFileUpload>

  </MudItem>

  @*
    GOAL: Goal for today is to unify how values are update for call controls.
    Some of the are doing wacky stuff in order just to display correct
    updated value.
  *@

  <MudItem xs="12" sm="6" md="6">
    <MudPaper Class="pa-4">
      <EditForm Model="@_model" OnValidSubmit="@OnValidSubmit">
        <DataAnnotationsValidator/>

        @* Update sources: user input, program *@
        <MudDatePicker 
          Label="Date" 
          For="@(() => _model.Date)"
          DateFormat="yyyy-MM-dd"
          ShowToolbar="false"
          @bind-Date="_model.Date" 
          @onkeydown="OnKeyDownDate"
          autofocus/>

        @* 
          Since transaction type is also controlling Receiver/Sender
          field, it requires a bit different approach how value is binded.
        *@
        <MudSelect 
          T="string"
          Label="Transaction type" 
          For="@(() => _model.TransactionType)"
          Value="_model.TransactionType"
          ValueChanged="@(v => UpdateTransactionType(v))"
          ValueExpression="@(() => _model.TransactionType)">

          @foreach (var opt in _transactionTypes)
          {
            <MudSelectItem Value="opt">@opt</MudSelectItem>
          }

        </MudSelect>

        @* 
           When the user types something that is not on the list and CoerceValue is true, 
           the Value will be overwritten with the user input which allows it to be 
           passed to the validation function. That way, user is NOT forced to provide
           values which exists only on the list.
        *@

         @* 
           @@TODO: Receiver filed is highlighted as "incorrect" when form is saved
           using Alt + S. It shouldn't be since no value has been yet provided.
           User will do it.

           @@BUG: Alt + S seems to to bypass validation as well and allow user 
           to commit transaction without specifying Receiver.
         *@

        <MudAutocomplete
          T="string"
          Label="Receiver/Sender"
          For="@(() => _model.Receiver)"
          CoerceValue="true"
          SearchFunc="SearchReceivers"
          @bind-Value="_model.Receiver"
          @ref="_receiverRef"
        />

        <MudNumericField
          T="decimal"
          Label="Amount" 
          For="@(() => _model.TotalAmount)"
          Value="_model.TotalAmount"
          ValueChanged="@(v => UpdateTotalAmount(v))"
          ValueExpression="@(() => _model.TotalAmount)"
          Format="C"
          Culture="_culture"
        />

        <div>
          @foreach (var category in _model.Categories)
          {
            <div class="d-flex">
              @*
                CoerceValue is needed to allow user to enter new categories.
              *@
              <MudAutocomplete
                Label="Category"
                CoerceValue="true"
                SearchFunc="SearchCategory"
                @bind-Value="category.Name"
                @ref="category.Ref" 
              />

              @* 
                @@NOTE: As of of know, validation on each split-level is not available.
                This requires more work since Blazor does not support automatically traversing 
                lists or collections when validating nested objects.
                This feature has been added to .NET 10 which is now (2025-10-08) still in preview.
                Planned release maybe in November?
                See: https://learn.microsoft.com/en-us/aspnet/core/blazor/forms/validation?view=aspnetcore-10.0#nested-objects-and-collection-types
                Here how it could be implemented: https://learn.microsoft.com/en-us/aspnet/core/blazor/forms/validation?view=aspnetcore-10.0#nested-objects-and-collection-types

                This is check performed in OnValidSubmit method.
              *@
              <MudNumericField
                Label="Split amount" 
                Format="C"
                Culture="_culture"
                Immediate="true"
                @bind-Value="category.Amount"
              />

              <MudIconButton 
                Icon="@Icons.Material.Filled.Delete" 
                Color="Color.Primary" 
                OnClick="@(() => RemoveCategory(category))" />
            </div>
          }

          <MudButton 
            class="mt-2"
            Variant="Variant.Outlined" 
            Color="Color.Primary" 
            OnClick="AddCategory">
            <MudIcon Icon="@Icons.Material.Filled.Add" />
              Split
          </MudButton>

          <MudTextField 
            Label="Notes" 
            Lines="3"
            Variant="Variant.Outlined" 
            Adornment="Adornment.Start" 
            AdornmentColor="Color.Info"
            @bind-Value="_model.Notes" 
            @ref="_notesRef"
          />

        </div>

        <div class="d-flex flex-row-reverse">
          <MudButton 
            ButtonType="ButtonType.Submit"
            Variant="Variant.Filled"
            Color="Color.Primary"
            Class="ml-auto">
            Save
          </MudButton>
        </div>
      </EditForm>

      <div class="d-flex flex-row-reverse mt-2">
          <MudButton 
            Variant="Variant.Outlined" 
            Color="Color.Primary" 
            OnClick="@(() => ExportToDisc())">
            <MudIcon Icon="@Icons.Material.Filled.Download" />
            Export
          </MudButton>
      </div>


    </MudPaper>
  </MudItem>
</div>

<MudSimpleTable Class="mt-4">

  <thead>
    <tr>
      <th>Date</th>
      <th>Type</th>
      <th>Receiver</th>
      <th>Total Amount</th>
    </tr>
  </thead>

  <tbody>
    @foreach(var p in _payments)
    {
      <tr>
        <td>@p.Date.ToString("yyyy-MM-dd")</td>
        <td>@p.TransactionType</td>
        <td>@p.Payee</td>
        <td>@p.TotalAmount.ToString("C", CultureInfo.CreateSpecificCulture("pl"))</td>
      </tr>
    }
  </tbody>

</MudSimpleTable>

<MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="_isDarkMode"/>
<MudPopoverProvider />

@* Needed for snackbars/toasts *@
<MudSnackbarProvider />

<script>
  window.downloadFileFromStream = async (fileName, contentStreamReference) => {
    const arrayBuffer = await contentStreamReference.arrayBuffer();
    const blob = new Blob([arrayBuffer]);
    const url = URL.createObjectURL(blob);
    const anchorElement = document.createElement('a');
    anchorElement.href = url;
    anchorElement.download = fileName ?? '';
    anchorElement.click();
    anchorElement.remove();
    URL.revokeObjectURL(url);
  }
</script>

@code {
  // Page related fields.
  private MudAutocomplete<string>? _receiverRef;
  private MudTextField<string> _notesRef;
  private DotNetObjectReference<Home>? _thisComponent;

  // Control dark mode based on system preference.
  private bool _isDarkMode = true;
  private MudThemeProvider? _mudThemeProvider;

  private CultureInfo _culture = CultureInfo.CreateSpecificCulture("pl");

  // Model for the form.
  private TransactionForm _model = new()
  {
    Categories = [new CategoryAmount() { Name = "", Amount = 0 }]
  };

  // In-memory storage for payments.
  // These payments might be used to export to a file later.
  private readonly List<Payment> _payments = new();

  private IEnumerable<string> _transactionTypes = [
    "Deposit",
    "Withdrawal",
    "Transfer"
  ];
  
  private string[] _searchSpaceCategory = [];
  private string[] _searchSpaceReceivers = [];
  private Queue<BankTransaction> _bankTransactions = [];
  private CategorySearchEngine _categorySearchEngine;
  private string[] _knownPayees = [];
  private string[] _knownAccounts = [];

  protected override void OnInitialized()
  {
    _searchSpaceCategory = AppSettingsOptions.Value.TransactionCategories.ToArray();
    _knownPayees = AppSettingsOptions.Value.Receivers.ToArray();
    _knownAccounts = AppSettingsOptions.Value.Accounts.ToArray();
    _categorySearchEngine = new CategorySearchEngine(_searchSpaceCategory);
    Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);

    _searchSpaceReceivers = _knownPayees; 
  }

  protected async override Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      if (_mudThemeProvider is not null)
      {
        _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
      }

      _thisComponent = DotNetObjectReference.Create(this);
      if (_thisComponent is not null)
      {
        await JSRuntime.InvokeVoidAsync("EnableKeyboardCapture", _thisComponent);
      }

      StateHasChanged();
    }
  }

  private async Task<IEnumerable<string>> SearchCategory(
    string phrase,
    CancellationToken token)
  {
    if (string.IsNullOrEmpty(phrase))
    {
      return _searchSpaceCategory;
    }

    IEnumerable<string> result = _categorySearchEngine.Search(phrase, StringComparison.OrdinalIgnoreCase);
    return await Task.FromResult(result);
  }

  /// <summary>
  /// Handle key presses when the date input is focused.
  /// </summary>
  /// <param name="args">Information about which key was pressed.</param>
  private void OnKeyDownDate(KeyboardEventArgs args)
  {
    if (_model.Date == null)
    {
      _model.Date = DateTime.Today;
      return;
    }

    if (args.CtrlKey)
    {
      return;
    }

    if (args.Key == "=")
    {
      _model.Date = _model.Date.Value.AddDays(1);
    }
    else if (args.Key == "-")
    {
      _model.Date = _model.Date.Value.AddDays(-1);
    }
  }

  private async Task OnValidSubmit(EditContext context)
  {
    // @@NOTE: Right now, I'm assuming the form is always valid.
    // In a real application, you would check the validation state.
    var transactionType = _model.TransactionType switch
    {
      "Deposit" => MMEXTransactionTypes.Deposit,
      "Withdrawal" => MMEXTransactionTypes.Withdrawal,
      "Transfer" => MMEXTransactionTypes.Transfer,
      _ => MMEXTransactionTypes.Unknown
    };

    var categories = new List<Category>();
    foreach (var cat in _model.Categories)
    {
      string[] split = cat.Name.Split(":");
      string name = split.First();

      // Some transactions will not have subcategory available.
      // In those cases, don't provide any.
      string subcategory = split.Length == 1 ? "" : split.Last();
      decimal amount = cat.Amount;

      categories.Add(new Category(name, subcategory, amount));
    }

    // Convert TransactionModel to Payment entity.

    // Since this can throw, make sure user gets information about it
    // and do not crash entire site.

    Payment? result = null;
    try {
      result = new Payment
      (
        date: _model.Date!.Value,
        transactionType: transactionType,
        totalAmount: _model.TotalAmount,
        payee: _model.Receiver,
        categories: categories,
        notes: _model.Notes
      );
    } catch (ArgumentException)
    {
      // Show toast message about the problem and do not add transaction
      // to the list.
      Snackbar.Add(
        "Sum of all categories is not equal to total amount.",
        Severity.Warning);
      return;
    }

    // If for whatever reason result is null, throw.
    if (result is null)
    {
      throw new InvalidOperationException(
        $"Expected to have non-null value for '{nameof(result)}'");
    }

    _payments.Add(result);

    Console.WriteLine("Form is valid");

    // Setup model for the new transaction.
    if (_receiverRef is not null)
    {
      _model.Receiver = "";

      // @@NOTE: When I invoke StateHasChanged at the end of the method
      // component is not refreshed. If I put it here, everything works.
      // using await InvokeAsync(() => _receiverRef.ForceRender(true)) also works
      // as a substitute of await InvokeAsync(StateHasChanged).
      // I'm using ForceRender since, I can target which component 
      // has to be updated, also ForceRender also does StateHasChanged() call.

      _receiverRef.ForceRender(true);
      await _receiverRef.BlurAsync();
      await _receiverRef.FocusAsync();
      await _receiverRef.CloseMenuAsync();
    }

    /* 
      Because clearing entire set of categories and adding back one
      does not notifies renderer to render new value, I will not removing
      all elements from categories. I will always keep one which is rendered
      and operate on in.

      There is hacky way of refreshing entire div using @key attribute
      in div but opted to do it more directly.
    */ 
    if (_model.Categories.Count >= 2)
    {
      _model.Categories.RemoveRange(1, _model.Categories.Count - 1);
    }

    _model.Categories[0].Name = "";
    _model.Categories[0].Ref.ForceRender(true);

    await PrefillFormWithNextTransaction();
    Snackbar.Add("Transaction created successfully.", Severity.Success);

    StateHasChanged();
  }

  /// <summary>
  /// Handle key presses from JavaScript.
  /// </summary>
  /// <param name="e">Information about which key was pressed.</param>
  [JSInvokable]
  public async Task JsKeyDown(KeyboardEventArgs e)
  {
    if (e.AltKey && e.Key.ToLower() == "a")
    {
      await AddCategory();
    }

    if (e.AltKey && e.Key.ToLower() == "s")
    {
      await OnValidSubmit(null!);
    }
  }

  /// <summary>
  /// Adds a new row with category name and amount assigned to it for user entry.
  /// If there is unallocated sum of money, new category will auto-fill with 
  /// the difference.
  /// </summary>
  private async Task AddCategory()
  {
    // Drop focus from any input to avoid issues with MudBlazor components.
    foreach (var cat in _model.Categories)
    {
      if (cat.Ref is not null)
      {
        await cat.Ref.CloseMenuAsync();
      }
    }

    var newCategory = new CategoryAmount();
    _model.Categories.Add(newCategory);

    if (_model.Categories.Count >= 2)
    {
      decimal sum = _model.Categories.Sum(c => c.Amount);
      decimal diff = _model.TotalAmount - sum;

      if (diff < 0)
      {
        diff = 0;
      }
      newCategory.Amount = diff;
    }

    // First, render element to the DOM so that Ref is not null.
    // Then, focus the newly added category input.
    if (newCategory.Ref is not null)
    {
      await newCategory.Ref.FocusAsync();
    }
    StateHasChanged();
  }

  private void RemoveCategory(CategoryAmount category)
  {
    if (_model.Categories.Count > 1 && category != null)
    {
      _model.Categories.Remove(category);
      StateHasChanged();
    }
  }

  private async Task<IEnumerable<string>> SearchReceivers(
    string phrase,
    CancellationToken token)
  {
    if (string.IsNullOrEmpty(phrase))
    {
      return _searchSpaceReceivers;
    }

    IEnumerable<string> result = _searchSpaceReceivers
      .Where(x => x.StartsWith(phrase, StringComparison.OrdinalIgnoreCase));

    return await Task.FromResult(result);
  }

  /// <summary>
  /// Update total amount and adjust the first category amount if there is only one category.
  /// </summary>
  /// <param name="value">New value of TotalAmount</param>
  private void UpdateTotalAmount(decimal value)
  {     
    _model.TotalAmount = value;

    if (_model.Categories.Count == 1)
    {
      _model.Categories[0].Amount = value;
    }
  }

  /// <summary>
  /// Export all saved transactions into QIF format.
  /// </summary>
  private async Task ExportToDisc()
  {
    var builder = new QifBuilder("Wspólne");
    foreach (var payment in _payments)
    {
      builder = builder.AddTransaction(payment);
    }

    string qifContent = builder.Build();
    byte[] bytes = System.Text.Encoding.UTF8.GetBytes(qifContent);
    var s = new MemoryStream(bytes);

    var fileName = $"transactions-{DateTime.Now:yyyyMMddHHmmss}.qif";
    using var streamRef = new DotNetStreamReference(stream: s);
    await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
  }

  private async Task UploadBankStatement(IBrowserFile file)
  {
    if (Path.GetExtension(file.Name).ToLower() != ".csv")
    {
      Snackbar.Add("Bank statements can be only be in CSV format.", Severity.Warning);
      return;
    }

    // @@NOTE: Uploading bank statement for the second time
    // will override previous value.

    // Since I know that my statement will contains Polish symbols like ą, ć, ę, ł and others
    // correct codepage has to be loaded.
    using StreamReader sr = new StreamReader(file.OpenReadStream(), Encoding.GetEncoding(1250));
    string content = await sr.ReadToEndAsync();
    string[] allLines = content.Split(Environment.NewLine, StringSplitOptions.None);

    // Transactions will be displayed in order of the oldest to newest.
    // This is how I typically fill my budget.
    IEnumerable<BankTransaction> transactions = BankStatementParser.Parse(allLines, skipHeader: true)
    .OrderBy(x => x.CurrencyDate);

    _bankTransactions = new Queue<BankTransaction>(transactions);

    await PrefillFormWithNextTransaction();
  }

  private async Task PrefillFormWithNextTransaction()
  {
    if (_bankTransactions != null && _bankTransactions.Count > 0)
    {
      BankTransaction next = _bankTransactions.Dequeue();
      _model.Date = next.CurrencyDate;

      // @@TODO: Incomplete.
      string transactionType = next.TransactionType switch {
        BankTransactionType.StandingOrder
        or BankTransactionType.CardPayment => "Withdrawal",

        _ => "Withdrawal"
      };
      UpdateTransactionType(transactionType);

      // @@NOTE: Using absolute value since TransactionType
      // will determine if money should be added to bank account
      // or subtracted from it.

      UpdateTotalAmount(Math.Abs(next.Amount));

      var sb = new StringBuilder();
      if (next.TransactionType == BankTransactionType.CardPayment
        || next.TransactionType == BankTransactionType.MobileWebPayment)
      {
        sb.AppendLine($"Adres: {next.GetAddress()}");
      }
      else if (next.TransactionType == BankTransactionType.OutgoingAccountTransfer
        || next.TransactionType == BankTransactionType.StandingOrder)
      {
        sb.AppendLine($"Nazwa odbiorcy: {next.GetReceiverName()}");
        sb.AppendLine($"Tytul: {next.GetTitle()}");
      }

      _model.Notes = sb.ToString();
    }
  }

  // Updating transaction type might trigger change in search space
  // for receivers. It does not make sense to search in payee's names
  // when transferring money between own accounts.
  private void UpdateTransactionType(string value) 
  {
    // Alternative: Just update model?
    _model.TransactionType = value;
    if (_model.TransactionType == "Transfer") 
      _searchSpaceReceivers = _knownAccounts;
    else 
      _searchSpaceReceivers = _knownPayees;
  }
}
